# Copy to .env.local and fill in.

# Public origin of your deployment (no trailing slash). Used for canonical URLs,
# Open Graph/Twitter tags, sitemap, robots, and share links.
NEXT_PUBLIC_SITE_URL=https://predictle.app

# Signs puzzle tokens so the answer never reaches the client. Use a random value.
PUZZLE_SECRET=change-me

# LLM question-quality filter — any Anthropic-compatible endpoint.
# Leave PREDICTLE_LLM_FILTER=0 (or omit the token) to disable it.
PREDICTLE_LLM_FILTER=1
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
PREDICTLE_LLM_MODEL=claude-haiku-4-5-20251001
